{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maen1977/orthodox_prayers/schemas/rolling_week.schema.json",
  "title": "Orthodox Prayers Rolling Liturgical Window Package",
  "type": "object",
  "required": [
    "date_iso",
    "rolling_week",
    "weekly_days",
    "services",
    "readings"
  ],
  "properties": {
    "rolling_week": {
      "type": "object",
      "required": [
        "schema_version",
        "policy",
        "start_date",
        "end_date",
        "day_count",
        "status",
        "fail_closed"
      ],
      "properties": {
        "start_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "const": "COMPLETE"
        },
        "fail_closed": {
          "const": true
        }
      },
      "oneOf": [
        {
          "properties": {
            "schema_version": { "const": 1 },
            "policy": { "const": "NINE_CONSECUTIVE_DAYS_STARTING_TODAY" },
            "day_count": { "const": 9 }
          }
        },
        {
          "properties": {
            "schema_version": { "const": 2 },
            "policy": { "const": "ROLLING_FUTURE_WINDOW" },
            "day_count": { "type": "integer", "minimum": 9, "maximum": 42 },
            "future_day_count": { "type": "integer", "minimum": 8, "maximum": 41 },
            "end_offset_days": { "type": "integer", "minimum": 8, "maximum": 41 },
            "timezone": { "const": "Asia/Amman" },
            "refresh_policy": { "const": "DAILY_REBUILD_SLIDING_HORIZON" }
          },
          "required": [
            "future_day_count",
            "end_offset_days",
            "timezone",
            "refresh_policy"
          ]
        }
      ]
    },
    "weekly_days": {
      "type": "array",
      "minItems": 8,
      "maxItems": 41,
      "items": {
        "type": "object"
      }
    }
  }
}
