.gradle/
build/
app/build/
# Generated release outputs stay untracked, but canonical branding assets are versioned.
release/*
!release/branding/
!release/branding/Church-Prayers.ico
!release/branding/Church-Prayers-icon-512.png
!release/branding/WINDOWS_DESKTOP_ICON_AR.txt
local.properties
*.iml
.DS_Store
__pycache__/
.pytest_cache/
*.py[cod]

# Runtime canonical download cache
.cache/

# Never commit Android signing material
*.jks
*.keystore
*.p12
*.pem
keystore.properties

# Data-signing secrets must remain outside the repository
*_PRIVATE_KEY*
*private*.key
*private*.der
*.key

# Detached public signatures and public keys are committed intentionally

# Generated validation and handoff output
reports/
FILE_SHA256SUMS.txt
VERIFICATION_AR.txt
*.zip.sha256

# Licensed raw source exports and permission documents stay outside the public repository
private-source-bundles/
permission-documents/
authorized-source-snapshots/

# Explicitly reject the private handoff bundle files
GITHUB_SECRETS.txt
android-signing/
data-signing/*PRIVATE*
اقرأني-أولا-الحزمة-الكاملة.txt

# Authorized liturgical source files are local-only.
private_sources/
# Generated rolling-window candidates must never be committed
data/rolling-week/candidates/
