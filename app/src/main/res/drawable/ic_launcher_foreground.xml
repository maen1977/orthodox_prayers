<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Adaptive-icon canvas is 108dp. The cross itself is pre-scaled to the
         Android 66dp safe zone so circular and squircle launchers never crop it. -->
    <item android:gravity="center">
        <bitmap
            android:src="@drawable/church_prayers_cross_foreground"
            android:gravity="center"
            android:antialias="true"
            android:filter="true" />
    </item>
</layer-list>
