    {
      "id": "small_compline",
      "category": "daily",
      "icon": "🌙",
      "title": {
        "ar": "صلاة النوم الصغرى",
        "en": "",
        "el": ""
      },
      "summary": {
        "ar": "ترتيب مختصر للصلاة قبل النوم.",
        "en": "",
        "el": ""
      },
      "segments": [
        {
          "type": "note",
          "speaker": {
            "ar": "تنبيه النص",
            "en": "",
            "el": ""
          },
          "text": {
            "ar": "يعرض هذا القارئ النص العربي المقروء المثبت داخل المشروع فقط، ويخفي نسخة المسح القديمة المشوّهة. القطع غير المتوفرة بنص عربي أصلي متحقق لا تُستكمل بالتخمين أو الترجمة الآلية.",
            "en": "",
            "el": ""
          },
          "editorial_metadata_only": true,
          "collapsed_by_default": true
        },
        {
          "type": "text",
          "speaker": {
            "ar": "القارئ",
            "en": "",
            "el": ""
          },
          "text": {
            "ar": "ارحمني يا الله كعظيم رحمتك، وكمثل كثرة رأفتك امحُ مآثمي.",
            "en": "",
            "el": ""
          }
        },
        {
          "type": "text",
          "speaker": {
            "ar": "القارئ",
            "en": "",
            "el": ""
          },
          "text": {
            "ar": "أعترف لك يا رب بكل ضعف وخطيئة، وأطلب منك قلباً نقياً وروحاً مستقيماً.",
            "en": "",
            "el": ""
          }
        },
        {
          "type": "text",
          "speaker": {
            "ar": "القارئ",
            "en": "",
            "el": ""
          },
          "text": {
            "ar": "يا والدة الإله، يا رجاء غير الخازين، كوني لي شفاعة ومعونة، واحفظيني تحت ستر ابنك.",
            "en": "",
            "el": ""
          }
        },
        {
          "type": "text",
          "speaker": {
            "ar": "الجميع",
            "en": "",
            "el": ""
          },
          "text": {
            "ar": "بين يديك يا رب أستودع روحي وجسدي، فباركني وارحمني. آمين.",
            "en": "",
            "el": ""
          }
        }
      ],
      "reader_scope": "READABLE_FIXED_CORE_ONLY_NOT_COMPLETE_OFFICE",
