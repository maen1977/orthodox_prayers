  "offsets": {
    "-7": {
      "id": "palm_sunday",
      "name": {
        "ar": "أحد الشعانين",
        "en": "Palm Sunday",
        "el": "Κυριακὴ τῶν Βαΐων"
      },
      "troparion": {
        "ar": "لما أقمت لعازر من بين الأموات قبل آلامك، حققت القيامة العامة أيها المسيح الإله. لذلك نحن أيضًا كالأطفال نحمل علامات الغلبة والنصر، ونهتف إليك يا غالب الموت: أوصنا في الأعالي، مبارك الآتي باسم الرب.",
        "en": "By raising Lazarus from the dead before Your Passion, You confirmed the universal resurrection, O Christ God. Like the children with the palms of victory, we cry out to You, O Vanquisher of death: Hosanna in the highest! Blessed is He who comes in the name of the Lord.",
        "el": "Τὴν κοινὴν Ἀνάστασιν πρὸ τοῦ σου Πάθους πιστούμενος, ἐκ νεκρῶν ἤγειρας τὸν Λάζαρον, Χριστὲ ὁ Θεός· ὅθεν καὶ ἡμεῖς, ὡς οἱ Παῖδες, τὰ τῆς νίκης σύμβολα φέροντες, σοὶ τῷ νικητῇ τοῦ θανάτου βοῶμεν· Ὡσαννὰ ἐν τοῖς ὑψίστοις, εὐλογημένος ὁ ἐρχόμενος ἐν ὀνόματι Κυρίου."
      },
      "kontakion": {
        "ar": "أيها المسيح الإله، يا من في السماء على العرش وعلى الأرض على جحش مركوبًا، لقد قبلت تسبيح الملائكة ونشيد الأطفال الهاتفين إليك: مبارك أنت يا من أتيت لتدعو آدم.",
        "en": "Enthroned in heaven and riding on a colt on earth, O Christ God, You accepted the praise of the angels and the hymn of the children who cried to You: Blessed are You who come to restore Adam.",
        "el": "Τῷ θρόνῳ ἐν οὐρανῷ, τῷ πώλῳ ἐπὶ τῆς γῆς ἐποχούμενος Χριστὲ ὁ Θεός, τῶν Ἀγγέλων τὴν αἴνεσιν καὶ τῶν Παίδων ἀνύμνησιν προσεδέξω βοώντων σοι· Εὐλογημένος εἶ ὁ ἐρχόμενος, τὸν Ἀδὰμ ἀνακαλέσασθαι."
      },
      "communion": {
        "ar": "مبارك الآتي باسم الرب. الله الرب ظهر لنا. هللويا.",
        "en": "Blessed is He who comes in the name of the Lord. God is the Lord and has revealed Himself to us. Alleluia.",
        "el": "Εὐλογημένος ὁ ἐρχόμενος ἐν ὀνόματι Κυρίου. Θεὸς Κύριος καὶ ἐπέφανεν ἡμῖν. Ἀλληλούϊα."
      },
      "prokeimenon": {
        "tone": 4,
        "title": {
          "ar": "البروكيمنن — اللحن الرابع",
          "en": "Prokeimenon — Tone 4",
          "el": "Προκείμενον — Ἦχος δ΄"
        },
        "reference": {
          "ar": "مزمور 117:26، 27",
          "en": "Psalm 117:26, 27 (LXX)",
          "el": "Ψαλμός 117:26, 27"
        },
        "body": {
          "ar": "مبارك الآتي باسم الرب.\nالله الرب ظهر لنا.",
          "en": "Blessed is He who comes in the name of the Lord.\nGod is the Lord and has revealed Himself to us.",
          "el": "Εὐλογημένος ὁ ἐρχόμενος ἐν ὀνόματι Κυρίου.\nΘεὸς Κύριος καὶ ἐπέφανεν ἡμῖν."
        }
      },
