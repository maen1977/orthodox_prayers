    "39": {
      "id": "ascension_lord",
      "name": {
        "ar": "صعود ربنا وإلهنا ومخلصنا يسوع المسيح",
        "en": "Ascension of our Lord",
        "el": "Ἡ Ἀνάληψις τοῦ Κυρίου"
      },
      "troparion": {
        "ar": "صعدت بالمجد أيها المسيح إلهنا، وفرحت تلاميذك بموعد الروح القدس، إذ أيقنوا بالبركة أنك أنت ابن الله منقذ العالم.",
        "en": "O Christ our God, You ascended in glory and gladdened Your disciples by the promise of the Holy Spirit. Your blessing assured them that You are the Son of God, the Redeemer of the world.",
        "el": "Ἀνελήφθης ἐν δόξῃ, Χριστὲ ὁ Θεὸς ἡμῶν, χαροποιήσας τοὺς Μαθητάς, τῇ ἐπαγγελίᾳ τοῦ ἁγίου Πνεύματος, βεβαιωθέντων αὐτῶν διὰ τῆς εὐλογίας, ὅτι σὺ εἶ ὁ Υἱὸς τοῦ Θεοῦ, ὁ Λυτρωτὴς τοῦ κόσμου."
      },
      "kontakion": {
        "ar": "لمّا أتممت التدبير الذي من أجلنا، وجعلت الذين على الأرض متحدين بالسماويين، صعدت بمجد أيها المسيح إلهنا، غير منفصل من مكان، بل ثابتًا بغير افتراق، وهاتفًا: أنا معكم وليس أحد عليكم.",
        "en": "O Christ our God, upon fulfilling Your dispensation for our sake, You ascended in glory, uniting the earthly with the heavenly. You were never separate but remained inseparable, and cried out to those who love You: I am with you and no one is against you.",
        "el": "Τὴν ὑπὲρ ἡμῶν πληρώσας οἰκονομίαν, καὶ τὰ ἐπὶ γῆς ἑνώσας τοῖς οὐρανίοις, ἀνελήφθης ἐν δόξῃ, Χριστὲ ὁ Θεὸς ἡμῶν, οὐδαμόθεν χωριζόμενος, ἀλλὰ μένων ἀδιάστατος, καὶ βοῶν τοῖς ἀγαπῶσί σε· Ἐγώ εἰμι μεθ᾿ ὑμῶν, καὶ οὐδεὶς καθ᾿ ὑμῶν."
      },
      "communion": {
        "ar": "صعد الله بتهليل، والرب بصوت البوق. هللويا.",
        "en": "God has ascended with a shout, the Lord with the sound of a trumpet. Alleluia.",
        "el": "Ἀνέβη ὁ Θεὸς ἐν ἀλαλαγμῷ, Κύριος ἐν φωνῇ σάλπιγγος. Ἀλληλούϊα."
      },
      "prokeimenon": {
        "tone": 7,
        "title": {
          "ar": "البروكيمنن — اللحن السابع",
          "en": "Prokeimenon — Tone 7",
          "el": "Προκείμενον — Ἦχος βαρύς"
        },
        "reference": {
          "ar": "مزمور 46:6، 2",
          "en": "Psalm 46:6, 2 (LXX)",
          "el": "Ψαλμός 46:6, 2"
        },
        "body": {
          "ar": "صعد الله بتهليل، والرب بصوت البوق.\nيا جميع الأمم صفقوا بالأيادي.",
          "en": "God has ascended with a shout, the Lord with the sound of a trumpet.\nClap your hands, all peoples.",
          "el": "Ἀνέβη ὁ Θεὸς ἐν ἀλαλαγμῷ, Κύριος ἐν φωνῇ σάλπιγγος.\nΠάντα τὰ ἔθνη κροτήσατε χεῖρας."
        }
      },
