    "49": {
      "id": "holy_pentecost",
      "name": {
        "ar": "أحد العنصرة المقدسة",
        "en": "Holy Pentecost",
        "el": "Ἡ Ἁγία Πεντηκοστή"
      },
      "troparion": {
        "ar": "مبارك أنت أيها المسيح إلهنا، يا من أظهرت الصيادين غزيري الحكمة، إذ سكبت عليهم الروح القدس، وبهم اصطدت المسكونة. يا محب البشر المجد لك.",
        "en": "Blessed are You, O Christ our God. You made the fishermen all-wise by sending down upon them the Holy Spirit, and through them You drew the world into Your net. O Lover of mankind, glory to You.",
        "el": "Εὐλογητὸς εἶ Χριστὲ ὁ Θεὸς ἡμῶν, ὁ πανσόφους τοὺς ἁλιεῖς ἀναδείξας, καταπέμψας αὐτοῖς τὸ Πνεῦμα τὸ Ἅγιον, καὶ δι᾿ αὐτῶν τὴν οἰκουμένην σαγηνεύσας, φιλάνθρωπε, δόξα σοι."
      },
      "kontakion": {
        "ar": "لمّا نزل العلي وبلبل الألسنة، قسّم الأمم، ولمّا وزّع الألسنة النارية دعا الكل إلى اتحاد واحد. لذلك نمجد الروح الكلي قدسه باتفاق الأصوات.",
        "en": "When the Most High came down and confused the tongues, He divided the nations; but when He distributed the tongues of fire, He called all to unity. Therefore, with one voice we glorify the all-holy Spirit.",
        "el": "Ὅτε καταβὰς τὰς γλώσσας συνέχεε, διεμέριζεν ἔθνη ὁ Ὕψιστος· ὅτε τοῦ πυρὸς τὰς γλώσσας διένειμεν, εἰς ἑνότητα πάντας ἐκάλεσε· καὶ συμφώνως δοξάζομεν τὸ Πανάγιον Πνεῦμα."
      },
      "communion": {
        "ar": "روحك الصالح يهديني في أرض مستقيمة. هللويا.",
        "en": "Your good Spirit shall lead me in the land of uprightness. Alleluia.",
        "el": "Τὸ Πνεῦμά σου τὸ ἀγαθὸν ὁδηγήσει με ἐν γῇ εὐθείᾳ. Ἀλληλούϊα."
      },
      "prokeimenon": {
        "tone": 8,
        "title": {
          "ar": "البروكيمنن — اللحن الثامن",
          "en": "Prokeimenon — Tone 8",
          "el": "Προκείμενον — Ἦχος πλ. δ΄"
        },
        "reference": {
          "ar": "مزمور 18:5، 2",
          "en": "Psalm 18:5, 2 (LXX)",
          "el": "Ψαλμός 18:5, 2"
        },
        "body": {
          "ar": "إلى كل الأرض خرج صوتهم وإلى أقاصي المسكونة أقوالهم.\nالسماوات تحدث بمجد الله.",
          "en": "Their proclamation has gone out into all the earth, and their words to the ends of the universe.\nThe heavens declare the glory of God.",
          "el": "Εἰς πᾶσαν τὴν γῆν ἐξῆλθεν ὁ φθόγγος αὐτῶν, καὶ εἰς τὰ πέρατα τῆς οἰκουμένης τὰ ῥήματα αὐτῶν.\nΟἱ οὐρανοὶ διηγοῦνται δόξαν Θεοῦ."
        }
      },
