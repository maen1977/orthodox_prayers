[{"automatic_diacritization_used":false,"book_id":"1CO","book_name":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α΄","chapter":12,"id":"1CO.12.12","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"Καθάπερ γὰρ τὸ σῶμα ἕν ἐστι καὶ μέλη ἔχει πολλά, πάντα δὲ τὰ μέλη τοῦ σώματος τοῦ ἑνός, πολλὰ ὄντα, ἕν ἐστι σῶμα, οὕτω καὶ ὁ Χριστός·","text_sha256":"a0aa6ca12ebbb40d3f344915369d741a76b053d5ef37b6635cdab80c12a59509","verse":12},{"automatic_diacritization_used":false,"book_id":"1CO","book_name":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α΄","chapter":12,"id":"1CO.12.13","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"καὶ γὰρ ἐν ἑνὶ Πνεύματι ἡμεῖς πάντες εἰς ἓν σῶμα ἐβαπτίσθημεν, εἴτε Ἰουδαῖοι εἴτε Ἕλληνες, εἴτε δοῦλοι εἴτε ἐλεύθεροι, καὶ πάντες εἰς ἓν Πνεῦμα ἐποτίσθημεν.","text_sha256":"71cdf75447a53fb6f73dea11d9def7ca8be1dc1a12f9c33e350a61cac4c78c3c","verse":13},{"automatic_diacritization_used":false,"book_id":"1CO","book_name":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α΄","chapter":12,"id":"1CO.12.14","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"καὶ γὰρ τὸ σῶμα οὐκ ἔστιν ἓν μέλος, ἀλλὰ πολλά.","text_sha256":"f7ddaaa9fd29271c4c2ca22a28023949db8fbd78760313f64c564b83dc09e86c","verse":14},{"automatic_diacritization_used":false,"book_id":"1CO","book_name":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α΄","chapter":12,"id":"1CO.12.15","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"ἐὰν εἴπῃ ὁ πούς, ὅτι οὐκ εἰμὶ χείρ, οὐκ εἰμὶ ἐκ τοῦ σώματος, — οὐ παρὰ τοῦτο οὐκ ἔστιν ἐκ τοῦ σώματος;","text_sha256":"ec683095d5370c1c15dd6b1868218d5ad5344e0ee8ca217cc50aad3b3a8908ae","verse":15},{"automatic_diacritization_used":false,"book_id":"1CO","book_name":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α΄","chapter":12,"id":"1CO.12.16","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"καὶ ἐὰν εἴπῃ τὸ οὖς, ὅτι οὐκ εἰμὶ ὀφθαλμός, οὐκ εἰμὶ ἐκ τοῦ σώματος, — οὐ παρὰ τοῦτο οὐκ ἔστιν ἐκ τοῦ σώματος;","text_sha256":"aec1abb7cc27c2bdd1f62d137d3e302918541414dfb5ae176bc931e3b13ad059","verse":16},{"automatic_diacritization_used":false,"book_id":"1CO","book_name":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α΄","chapter":12,"id":"1CO.12.17","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"εἰ ὅλον τὸ σῶμα ὀφθαλμός, ποῦ ἡ ἀκοή; εἰ ὅλον ἀκοή, ποῦ ἡ ὄσφρησις;","text_sha256":"d7aa38741bcbb225ccd27d2cc19ca3ef77a744129c13bc1fc621bfbe20842f37","verse":17},{"automatic_diacritization_used":false,"book_id":"1CO","book_name":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α΄","chapter":12,"id":"1CO.12.18","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"νυνὶ δὲ ὁ Θεὸς ἔθετο τὰ μέλη ἓν ἕκαστον αὐτῶν ἐν τῷ σώματι καθὼς ἠθέλησεν.","text_sha256":"87a5d5c744631ac82bfdf032aa91dc1ed7b132f1cc88aeb319cd12d6d7389a14","verse":18},{"automatic_diacritization_used":false,"book_id":"1CO","book_name":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α΄","chapter":12,"id":"1CO.12.19","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"εἰ δὲ ἦν τὰ πάντα ἓν μέλος, ποῦ τὸ σῶμα;","text_sha256":"0337c66e734426dea04e7182cf061f3bc2456b77266e064ffc1fd26d1b7ee1b8","verse":19},{"automatic_diacritization_used":false,"book_id":"1CO","book_name":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α΄","chapter":12,"id":"1CO.12.20","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"νῦν δὲ πολλὰ μὲν μέλη, ἓν δὲ σῶμα.","text_sha256":"87df94a0f6aa4bca24dadfc9b22e4c4c4a341874ab7abe6e509eedc8f66a9bff","verse":20},{"automatic_diacritization_used":false,"book_id":"1CO","book_name":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α΄","chapter":12,"id":"1CO.12.21","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"οὐ δύναται δὲ ὀφθαλμὸς εἰπεῖν τῇ χειρί· χρείαν σου οὐκ ἔχω· ἢ πάλιν ἡ κεφαλὴ τοῖς ποσί· χρείαν ὑμῶν οὐκ ἔχω·","text_sha256":"e2648f4eb48ececf85efed4641babb7fd208f70c6af560f44992fa29e419d60b","verse":21},{"automatic_diacritization_used":false,"book_id":"1CO","book_name":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α΄","chapter":12,"id":"1CO.12.22","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"ἀλλὰ πολλῷ μᾶλλον τὰ δοκοῦντα μέλη τοῦ σώματος ἀσθενέστερα ὑπάρχειν ἀναγκαῖά ἐστι,","text_sha256":"122ee9c8209961875ae1826cedc50db92480750eaed6bea12c624e1c45d00357","verse":22},{"automatic_diacritization_used":false,"book_id":"1CO","book_name":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α΄","chapter":12,"id":"1CO.12.23","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"καὶ ἃ δοκοῦμεν ἀτιμότερα εἶναι τοῦ σώματος, τούτοις τιμὴν περισσοτέραν περιτίθεμεν, καὶ τὰ ἀσχήμονα ἡμῶν εὐσχημοσύνην περισσοτέραν ἔχει,","text_sha256":"3aea2b85cbcf68aec56d2f4785da1f24fc46701c3c63ea7e4f8b89e65485554d","verse":23},{"automatic_diacritization_used":false,"book_id":"1CO","book_name":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α΄","chapter":12,"id":"1CO.12.24","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"τὰ δὲ εὐσχήμονα ἡμῶν οὐ χρείαν ἔχει. ἀλλ᾽ ὁ Θεὸς συνεκέρασε τὸ σῶμα, τῷ ὑστεροῦντι περισσοτέραν δοὺς τιμήν,","text_sha256":"aa61a371c60dad7d36ead953bc69f7af23151ce16ea1c1ea34eb53bb258249c8","verse":24},{"automatic_diacritization_used":false,"book_id":"1CO","book_name":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α΄","chapter":12,"id":"1CO.12.25","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"ἵνα μὴ ᾖ σχίσμα ἐν τῷ σώματι, ἀλλὰ τὸ αὐτὸ ὑπὲρ ἀλλήλων μεριμνῶσι τὰ μέλη·","text_sha256":"0e3becaaed9cb5a9e0dec541859e890c3b1cf7ba72e7324bb4a07ffe0087d3ee","verse":25},{"automatic_diacritization_used":false,"book_id":"1CO","book_name":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α΄","chapter":12,"id":"1CO.12.26","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"καὶ εἴτε πάσχει ἓν μέλος, συμπάσχει πάντα τὰ μέλη, εἴτε δοξάζεται ἓν μέλος, συγχαίρει πάντα τὰ μέλη.","text_sha256":"fee83cc9235516720709aa2b50c69fea3ea06fc1e48ab0bddfa18245a1bc7c7e","verse":26},{"automatic_diacritization_used":false,"book_id":"MAT","book_name":"ΤΟ ΚΑΤΑ ΜΑΤΘΑΙΟΝ ΑΓΙΟΝ ΕΥΑΓΓΕΛΙΟΝ","chapter":18,"id":"MAT.18.18","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"Ἀμὴν λέγω ὑμῖν, ὅσα ἐὰν δήσητε ἐπὶ τῆς γῆς, ἔσται δεδεμένα ἐν τῷ οὐρανῷ, καὶ ὅσα ἐὰν λύσητε ἐπὶ τῆς γῆς, ἔσται λελυμένα ἐν τῷ οὐρανῷ.","text_sha256":"6c3a65f098b008aae507c482dc12c63504a92ce67cf9cfea12f9234952391910","verse":18},{"automatic_diacritization_used":false,"book_id":"MAT","book_name":"ΤΟ ΚΑΤΑ ΜΑΤΘΑΙΟΝ ΑΓΙΟΝ ΕΥΑΓΓΕΛΙΟΝ","chapter":18,"id":"MAT.18.19","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"Πάλιν ἀμὴν λέγω ὑμῖν ὅτι ἐὰν δύο ὑμῶν συμφωνήσωσιν ἐπὶ τῆς γῆς περὶ παντὸς πράγματος οὗ ἐὰν αἰτήσωνται, γενήσεται αὐτοῖς παρὰ τοῦ πατρός μου τοῦ ἐν οὐρανοῖς.","text_sha256":"67fff385a9d75ebf6a4ea72195a02d73ec32b49241e8516118f4deb8dab3ae2c","verse":19},{"automatic_diacritization_used":false,"book_id":"MAT","book_name":"ΤΟ ΚΑΤΑ ΜΑΤΘΑΙΟΝ ΑΓΙΟΝ ΕΥΑΓΓΕΛΙΟΝ","chapter":18,"id":"MAT.18.20","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"οὗ γάρ εἰσι δύο ἢ τρεῖς συνηγμένοι εἰς τὸ ἐμὸν ὄνομα, ἐκεῖ εἰμι ἐν μέσῳ αὐτῶν.","text_sha256":"940d7596d7d7a6c1ca478c591511ad805e3587b5168ee9572202907f44fb4ef6","verse":20},{"automatic_diacritization_used":false,"book_id":"MAT","book_name":"ΤΟ ΚΑΤΑ ΜΑΤΘΑΙΟΝ ΑΓΙΟΝ ΕΥΑΓΓΕΛΙΟΝ","chapter":18,"id":"MAT.18.21","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"Τότε προσελθὼν αὐτῷ ὁ Πέτρος εἶπε· Κύριε, ποσάκις ἁμαρτήσει εἰς ἐμὲ ὁ ἀδελφός μου καὶ ἀφήσω αὐτῷ; ἕως ἑπτάκις;","text_sha256":"1a07a8e960ea2c05b28e2d713cef8adc72f8ae0b348188919dc7b7cab124b539","verse":21},{"automatic_diacritization_used":false,"book_id":"MAT","book_name":"ΤΟ ΚΑΤΑ ΜΑΤΘΑΙΟΝ ΑΓΙΟΝ ΕΥΑΓΓΕΛΙΟΝ","chapter":18,"id":"MAT.18.22","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"λέγει αὐτῷ ὁ Ἰησοῦς· οὐ λέγω σοι ἕως ἑπτάκις, ἀλλ᾽ ἕως ἑβδομηκοντάκις ἑπτά.","text_sha256":"506b455201535e20d50706260b5cd570f25a1b0d04587becf13d95d026fc9af7","verse":22},{"automatic_diacritization_used":false,"book_id":"MAT","book_name":"ΤΟ ΚΑΤΑ ΜΑΤΘΑΙΟΝ ΑΓΙΟΝ ΕΥΑΓΓΕΛΙΟΝ","chapter":19,"id":"MAT.19.1","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"Καὶ ἐγένετο ὅτε ἐτέλεσεν ὁ Ἰησοῦς τοὺς λόγους τούτους μετῆρεν ἀπὸ τῆς Γαλιλαίας καὶ ἦλθεν εἰς τὰ ὅρια τῆς Ἰουδαίας πέραν τοῦ Ἰορδάνου.","text_sha256":"bb6fc3fc95c3486ea865534d48e5d5ac48984a6f12167f5b752cea6c7eba70b0","verse":1},{"automatic_diacritization_used":false,"book_id":"MAT","book_name":"ΤΟ ΚΑΤΑ ΜΑΤΘΑΙΟΝ ΑΓΙΟΝ ΕΥΑΓΓΕΛΙΟΝ","chapter":19,"id":"MAT.19.2","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"καὶ ἠκολούθησαν αὐτῷ ὄχλοι πολλοί, καὶ ἐθεράπευσεν αὐτοὺς ἐκεῖ.","text_sha256":"b433a083069abca0512344e37381ca52977bacef1720d547b8c711fb70243a8c","verse":2},{"automatic_diacritization_used":false,"book_id":"MAT","book_name":"ΤΟ ΚΑΤΑ ΜΑΤΘΑΙΟΝ ΑΓΙΟΝ ΕΥΑΓΓΕΛΙΟΝ","chapter":19,"id":"MAT.19.13","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"Τότε προσηνέχθη αὐτῷ παιδία, ἵνα ἐπιθῇ αὐτοῖς τὰς χεῖρας καὶ προσεύξηται· οἱ δὲ μαθηταὶ ἐπετίμησαν αὐτοῖς.","text_sha256":"a0e914f3d879f37c1a544366f3e387b90d68b56ca5a68e22018192f02a62c993","verse":13},{"automatic_diacritization_used":false,"book_id":"MAT","book_name":"ΤΟ ΚΑΤΑ ΜΑΤΘΑΙΟΝ ΑΓΙΟΝ ΕΥΑΓΓΕΛΙΟΝ","chapter":19,"id":"MAT.19.14","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"ὁ δὲ Ἰησοῦς εἶπεν· ἄφετε τὰ παιδία καὶ μὴ κωλύετε αὐτὰ ἐλθεῖν πρός με· τῶν γὰρ τοιούτων ἐστὶν ἡ βασιλεία τῶν οὐρανῶν.","text_sha256":"d6401dcefd0576a3cd28828a913bad662dc518adc72f08e9dee26fef285ec4d5","verse":14},{"automatic_diacritization_used":false,"book_id":"MAT","book_name":"ΤΟ ΚΑΤΑ ΜΑΤΘΑΙΟΝ ΑΓΙΟΝ ΕΥΑΓΓΕΛΙΟΝ","chapter":19,"id":"MAT.19.15","machine_translation_used":false,"source_id":"ebible_greek_byzantine_1904","source_url":"https://ebible.org/find/details.php?id=grcbyz","text":"καὶ ἐπιθεὶς τὰς χεῖρας αὐτοῖς ἐπορεύθη ἐκεῖθεν.","text_sha256":"2b8d2ffea2af9d954f0f8b76a269fdd360e46312947d5df3bed6062a6482d399","verse":15}]
