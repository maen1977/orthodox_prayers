{
  "id": "proskomide",
  "category": "liturgy",
  "icon": "☦",
  "title": {
    "ar": "خدمة التقدمة (البروسكوميدي)",
    "en": "",
    "el": ""
  },
  "summary": {
    "ar": "خدمة التقدمة كاملة: إعداد الحمل والكأس، أجزاء والدة الإله والقديسين، تذكارات الأحياء والراقدين، التغطية والتبخير وصلاة التقدمة.",
    "en": "",
    "el": ""
  },
  "native_pack_only": true,
  "segments": [
    {
      "type": "section",
      "title": {
        "ar": "خدمة التقدمة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "الاستعداد للخدمة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يقف الكاهن والشماس أمام المائدة المقدسة بثياب الخدمة، ويرسمان علامة الصليب ويسجدان ثلاث سجدات قائلين: اللهم ارحمني أنا الخاطئ. ثم يبتدئ الكاهن: مبارك إلهنا كل حين، الآن وكل أوان وإلى دهر الداهرين.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "الصلوات الافتتاحية",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "أيها الملك السماوي، المعزي، روح الحق، الحاضر في كل مكان والمالئ الكل، كنز الصالحات ورازق الحياة، هلم واسكن فينا وطهرنا من كل دنس وخلص أيها الصالح نفوسنا.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "قدوس الله، قدوس القوي، قدوس الذي لا يموت، ارحمنا. المجد للآب والابن والروح القدس، الآن وكل أوان وإلى دهر الداهرين. آمين.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "أيها الثالوث القدوس ارحمنا. يا رب اغفر خطايانا. يا سيد تجاوز عن سيئاتنا. يا قدوس اطلع واشف أمراضنا من أجل اسمك. يا رب ارحم ثلاثاً.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "أبانا الذي في السماوات، ليتقدس اسمك، ليأت ملكوتك، لتكن مشيئتك كما في السماء كذلك على الأرض. خبزنا الجوهري أعطنا اليوم، واترك لنا ما علينا كما نترك نحن لمن لنا عليه، ولا تدخلنا في تجربة لكن نجنا من الشرير.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "الاستعداد للقرابين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يهيئ الكاهن الحمل والخمر والماء والرمح والنجمة والأغطية، ويتحقق من أن القرابين صالحة للخدمة. ثم يبخر المذبح والمائدة ويقول: افتديتنا من لعنة الناموس بدمك الكريم، وإذ سمرت على الصليب وطعنت بالحربة أفَضت عدم الموت للبشر.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "رفع الحمل",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يرفع الكاهن القربانة بكلتا يديه ويقول: افتدانا الرب من لعنة الناموس. ثم يرسم بها الصليب فوق الصينية قائلاً: تذكاراً لربنا وإلهنا ومخلصنا يسوع المسيح.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "قطع الختم الأول",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يقطع الكاهن عن الجانب الأيمن من الختم قائلاً: كشاة سيق إلى الذبح.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "قطع الختم الثاني",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "ويقطع عن الجانب الأيسر قائلاً: وكحمل بريء أمام الذي يجزه لم يفتح فاه.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "قطع الختم الثالث",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "ويقطع من الأعلى قائلاً: في تواضعه انتزع حكمه.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "قطع الختم الرابع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "ويقطع من الأسفل قائلاً: وجيله من يصفه.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "إخراج الحمل",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يدخل الرمح إلى جانب القربانة ويرفع الحمل قائلاً: لأن حياته تؤخذ من الأرض. ثم يضع الحمل على الصينية والوجه المختوم إلى أسفل.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "شق الحمل",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يشق الكاهن الحمل من أسفله بشكل صليب من غير أن يفصله، قائلاً: ذبح حمل الله الرافع خطيئة العالم، من أجل حياة العالم وخلاصه.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "قلب الحمل",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يقلب الحمل بحيث يكون الختم إلى أعلى ويقول: ولما أتوا إلى يسوع لم يكسروا ساقيه، لكن واحداً من الجند طعن جنبه بحربة، وللوقت خرج دم وماء، والذي عاين شهد وشهادته حق.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "طعن الحمل",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يطعن الكاهن الجانب الأيمن من الختم بالرمح عند الحرف المخصص، تذكاراً لطعن جنب المخلص، ثم يبارك الخمر والماء ويصب المقدار اللائق في الكأس المقدسة.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "مزج الكأس",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يقول الشماس: بارك يا سيد الاتحاد المقدس. فيبارك الكاهن قائلاً: مبارك اتحاد قدساتك كل حين، الآن وكل أوان وإلى دهر الداهرين. آمين.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "ذبيحة والدة الإله",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يأخذ الكاهن جزءاً مثلثاً من القربانة ويقول: إكراماً وتذكاراً لسيدتنا الكلية القداسة، الفائقة البركات، المجيدة والدة الإله والدائمة البتولية مريم، التي بشفاعاتها تقبل يا رب هذه الذبيحة على مذبحك السماوي.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "وضع جزء والدة الإله",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يضع الجزء عن يمين الحمل قائلاً: قامت الملكة عن يمينك بثوب موشى بالذهب، مزينة بأنواع كثيرة.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "صفوف الملائكة والقديسين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يأخذ تسعة أجزاء تذكاراً لرؤساء الملائكة والملائكة، وللنبي السابق يوحنا المعمدان، وللأنبياء، وللرسل القديسين المكرمين، وللآباء القديسين، وللشهداء، وللآباء النساك، وللقديسين عديمي الفضة، ولجدي المسيح يواكيم وحنة وقديس اليوم وجميع القديسين.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "الصف الأول",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يضع الجزء الأول عن يسار الحمل قائلاً: إكراماً وتذكاراً لرؤساء الأجناد ميخائيل وجبرائيل وجميع القوات السماوية العديمة الأجساد.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "الصف الثاني",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "الجزء الثاني تذكاراً للسابق المجيد النبي يوحنا المعمدان، وللأنبياء موسى وهارون وإيليا وأليشع وداود ويسى، وللأنبياء القديسين أجمعين.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "الصف الثالث",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "الجزء الثالث تذكاراً للرسل القديسين المجيدين المكرمين بطرس وبولس، وللرسل الاثني عشر والسبعين وجميع المبشرين.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "الصف الرابع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "الجزء الرابع تذكاراً لآبائنا القديسين العظام معلمي المسكونة ورؤساء الكهنة، باسيليوس الكبير وغريغوريوس اللاهوتي ويوحنا الذهبي الفم وأثناسيوس وكيرلس ونيقولاوس وجميع رؤساء الكهنة القديسين.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "الصف الخامس",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "الجزء الخامس تذكاراً للشهيد الأول ورئيس الشمامسة استفانوس، وللشهداء العظام جاورجيوس وديمتريوس وثيودورس، وللشهداء والشهيدات القديسين أجمعين.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "الصف السادس",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "الجزء السادس تذكاراً لآبائنا القديسين المتوشحين بالله أنطونيوس وأفتيميوس وسابا المتقدس وأونوفريوس وأثناسيوس الأثوسي، ولجميع الآباء والأمهات النساك.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "الصف السابع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "الجزء السابع تذكاراً للقديسين العادمي الفضة وصانعي العجائب قزما ودميانوس وكيرس ويوحنا وبندلايمون وهرمولاوس وجميع القديسين الشافين.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "الصف الثامن",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "الجزء الثامن تذكاراً لجدي المسيح الإله يواكيم وحنة، وللقديس الذي يحمل الهيكل اسمه، ولقديس اليوم، ولجميع القديسين الذين بشفاعاتهم افتقدنا يا الله وخلصنا.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "الصف التاسع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "الجزء التاسع تذكاراً لأبينا بين القديسين يوحنا الذهبي الفم أو باسيليوس الكبير بحسب القداس المزمع إقامته.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "تذكار الأحياء",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يأخذ الكاهن أجزاء صغيرة تذكاراً للبطريرك والمطران والأسقف والكهنة والشمامسة والرهبان، ولحكام البلاد، ولمؤسسي الهيكل وخدامه، ولجميع الأحياء الذين طلبوا الصلاة، قائلاً لكل واحد: اذكر يا رب عبدك أو أمتك.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "تذكار الراقدين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "ثم يأخذ أجزاء تذكاراً للآباء والإخوة الراقدين، ولمن رقد على رجاء القيامة والحياة الأبدية، قائلاً: اذكر يا رب نفس عبدك أو أمتك، واغفر لهم كل خطيئة إرادية وغير إرادية.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "تذكار الكاهن",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "وفي الختام يأخذ جزءاً لنفسه قائلاً: اذكر يا رب عدم استحقاقي واغفر لي كل زلة إرادية وغير إرادية، ولا تمنع بسبب خطاياي نعمة روحك القدوس من القرابين الموضوعة.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "جمع الأجزاء",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يجمع الكاهن الأجزاء حول الحمل بترتيبها، متنبهاً إلى ألا تسقط، ويقول: اغسل يا رب بدمك الكريم خطايا المذكورين هنا، بشفاعات قديسيك.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "تبخير النجمة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يبخر النجمة ويضعها فوق الصينية قائلاً: وإذا النجم الذي رأوه في المشرق يتقدمهم حتى جاء ووقف فوق حيث كان الصبي.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "تغطية الصينية",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يبخر غطاء الصينية ويغطيها قائلاً: الرب قد ملك ولبس الجلال. لبس الرب القدرة وتمنطق بها، لأنه ثبت المسكونة فلن تتزعزع.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "تغطية الكأس",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يبخر غطاء الكأس ويغطيها قائلاً: سترت السماوات فضيلته وامتلأت الأرض من تسبيحه.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "الستر الكبير",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يبخر الستر الكبير ويغطي به الصينية والكأس قائلاً: استرنا بستر جناحيك واطرد عنا كل عدو ومحارب، وسالم حياتنا يا رب، وارحمنا وعالمك وخلص نفوسنا بما أنك صالح ومحب للبشر.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "تقدمة البخور",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يأخذ المبخرة ويقول: بخوراً نقدم لك أيها المسيح إلهنا رائحة طيب روحاني، فتقبله على مذبحك السماوي، وأرسل لنا عوضه نعمة روحك الكلي القداسة.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "صلاة التقدمة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يا الله إلهنا، يا من أرسل الخبز السماوي غذاء للعالم، ربنا وإلهنا يسوع المسيح، المخلص والفادي والمحسن الذي يباركنا ويقدسنا، بارك هذه التقدمة واقبلها على مذبحك الفائق السماوات.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "اذكر بما أنك صالح ومحب للبشر الذين قدموها والذين قدمت من أجلهم، واحفظنا بلا دينونة في إقامة أسرارك الإلهية، لأن اسمك الكلي الوقار والجليل قد تقدس وتمجد، أيها الآب والابن والروح القدس، الآن وكل أوان وإلى دهر الداهرين.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "section",
      "title": {
        "ar": "ختام خدمة التقدمة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يسجد الكاهن والشماس ثلاثاً ويقولان: مبارك إلهنا الذي هكذا سر أن يتمم. المجد لك يا مسيح الإله رجاءنا المجد لك. ثم تكون الصرفة بحسب اليوم، وتبقى القرابين مغطاة ومحفوظة بوقار إلى بدء القداس الإلهي.",
        "en": "",
        "el": ""
      },
      "speaker": {
        "ar": "الكاهن أو الشماس بحسب الموضع",
        "en": "",
        "el": ""
      }
    }
  ],
