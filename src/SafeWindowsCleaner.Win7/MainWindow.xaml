<Window x:Class="SafeWindowsCleaner.Win7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1020" Height="680" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">
  <Grid Background="#F3F5F7">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="205"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#243447">
      <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock x:Name="SideTitle" Foreground="White" FontSize="18" FontWeight="Bold" Margin="8,12,8,20"/>
          <Button x:Name="HomeButton" Click="HomeButton_Click"/>
          <Button x:Name="CleanButton" Click="CleanButton_Click"/>
          <Button x:Name="ProgramsButton" Click="ProgramsButton_Click"/>
          <Button x:Name="MemoryButton" Click="MemoryButton_Click"/>
          <Button x:Name="RestoreButton" Click="RestoreButton_Click"/>
          <Button x:Name="SettingsButton" Click="SettingsButton_Click"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="#DDE6EE" Margin="8"/>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="22">
      <TabControl x:Name="MainTabs" BorderThickness="0" Background="Transparent">
        <TabControl.Resources>
          <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style>
        </TabControl.Resources>
        <TabItem>
          <StackPanel VerticalAlignment="Center" MaxWidth="690">
            <TextBlock x:Name="WelcomeTitle" FontSize="30" FontWeight="Bold" Margin="0,0,0,12"/>
            <TextBlock x:Name="WelcomeBody" FontSize="16" Foreground="#44515E" Margin="0,0,0,30"/>
            <UniformGrid Columns="2">
              <Button x:Name="HomeScanButton" Height="58" Click="HomeScanButton_Click"/>
              <Button x:Name="HomeProgramsButton" Height="58" Click="ProgramsButton_Click"/>
              <Button x:Name="HomeMemoryButton" Height="58" Click="MemoryButton_Click"/>
              <Button x:Name="HomeRestoreButton" Height="58" Click="RestoreButton_Click"/>
            </UniformGrid>
          </StackPanel>
        </TabItem>

        <TabItem>
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock x:Name="CleanTitle" FontSize="25" FontWeight="Bold" Margin="0,0,0,12"/>
              <WrapPanel>
                <Button x:Name="ScanButton" Click="ScanButton_Click"/>
                <Button x:Name="CleanSelectedButton" Click="CleanSelectedButton_Click" IsEnabled="False"/>
              </WrapPanel>
              <TextBlock x:Name="CleanSummaryText" Margin="5,8,5,8"/>
            </StackPanel>
            <DataGrid x:Name="CleanupGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" SelectionMode="Extended">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn x:Name="CleanupSelectedColumn" Binding="{Binding IsSelected}" Width="45"/>
                <DataGridTextColumn x:Name="CleanupCategoryColumn" Binding="{Binding Category}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="CleanupPathColumn" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="CleanupSizeColumn" Binding="{Binding SizeText}" Width="110" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <TabItem>
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock x:Name="ProgramsTitle" FontSize="25" FontWeight="Bold" Margin="0,0,0,12"/>
              <WrapPanel>
                <Button x:Name="ProgramsRefreshButton" Click="ProgramsRefreshButton_Click"/>
                <Button x:Name="UninstallButton" Click="UninstallButton_Click"/>
              </WrapPanel>
              <TextBlock x:Name="ProgramsSummaryText" Margin="5,8"/>
            </StackPanel>
            <DataGrid x:Name="ProgramsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
              <DataGrid.Columns>
                <DataGridTextColumn x:Name="ProgramNameColumn" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn x:Name="ProgramPublisherColumn" Binding="{Binding Publisher}" Width="220"/>
                <DataGridTextColumn x:Name="ProgramVersionColumn" Binding="{Binding Version}" Width="120"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <TabItem>
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock x:Name="MemoryTitle" FontSize="25" FontWeight="Bold" Margin="0,0,0,12"/>
              <WrapPanel>
                <Button x:Name="ProcessesRefreshButton" Click="ProcessesRefreshButton_Click"/>
                <Button x:Name="CloseProcessButton" Click="CloseProcessButton_Click"/>
              </WrapPanel>
              <TextBlock x:Name="ProcessesSummaryText" Margin="5,8"/>
            </StackPanel>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DataGrid x:Name="ProcessesGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                <DataGrid.Columns>
                  <DataGridTextColumn x:Name="ProcessNameColumn" Binding="{Binding Name}" Width="180"/>
                  <DataGridTextColumn x:Name="ProcessWindowColumn" Binding="{Binding WindowDisplayText}" Width="*"/>
                  <DataGridTextColumn x:Name="ProcessMemoryColumn" Binding="{Binding MemoryText}" Width="140"/>
                </DataGrid.Columns>
              </DataGrid>
              <Border Grid.Row="1" Background="White" BorderBrush="#CCD4DB" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock x:Name="PagefileStatusText" FontWeight="Bold"/>
                  <TextBlock x:Name="PagefileInfoText" Foreground="#465565" Margin="0,6,0,8"/>
                  <WrapPanel>
                    <Button x:Name="ReservePagefileButton" Click="ReservePagefileButton_Click"/>
                    <Button x:Name="RestorePagefileButton" Click="RestorePagefileButton_Click"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </Grid>
          </DockPanel>
        </TabItem>

        <TabItem>
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock x:Name="RestoreTitle" FontSize="25" FontWeight="Bold" Margin="0,0,0,12"/>
              <WrapPanel>
                <Button x:Name="RestoreRefreshButton" Click="RestoreRefreshButton_Click"/>
                <Button x:Name="RestoreSelectedButton" Click="RestoreSelectedButton_Click"/>
                <Button x:Name="DeleteSelectedButton" Click="DeleteSelectedButton_Click"/>
              </WrapPanel>
              <TextBlock x:Name="RestoreSummaryText" Margin="5,8"/>
            </StackPanel>
            <DataGrid x:Name="RestoreGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
              <DataGrid.Columns>
                <DataGridTextColumn x:Name="RestorePathColumn" Binding="{Binding OriginalPath}" Width="*"/>
                <DataGridTextColumn x:Name="RestoreSizeColumn" Binding="{Binding SizeText}" Width="120"/>
                <DataGridTextColumn x:Name="RestoreDateColumn" Binding="{Binding CreatedAtText}" Width="165"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <TabItem>
          <StackPanel MaxWidth="580" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="SettingsTitle" FontSize="25" FontWeight="Bold" Margin="0,0,0,18"/>
            <TextBlock x:Name="LanguageLabel" FontWeight="Bold" Margin="0,0,0,7"/>
            <ComboBox x:Name="LanguageCombo" SelectionChanged="LanguageCombo_SelectionChanged" MinWidth="260">
              <ComboBoxItem Tag="ar"/>
              <ComboBoxItem Tag="en"/>
            </ComboBox>
          </StackPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>
