<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SafeWindowsCleaner</AssemblyName>
    <RootNamespace>SafeWindowsCleaner</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Version>2.4.0</Version>
    <AssemblyVersion>2.4.0.0</AssemblyVersion>
    <FileVersion>2.4.0.0</FileVersion>
    <InformationalVersion>2.4.0</InformationalVersion>
    <Authors>معن حنونة للستلايت</Authors>
    <Company>معن حنونة للستلايت</Company>
    <Product>منظف ويندوز الآمن Lite</Product>
    <Copyright>Copyright © 2026 معن حنونة للستلايت</Copyright>
    <Description>Administrator-first lightweight Windows cleaner for 4 GB RAM and HDD computers with safe temporary-file cleanup, complete upgrade replacement, recoverable quarantine, installed-program removal, simple heavy-application memory relief, a reversible adaptive 4/8/16 GB Windows page-file preset, graphics-memory information, restore points, and signed updates.</Description>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl Condition="'$(GitHubRepository)' != ''">https://github.com/$(GitHubRepository)</RepositoryUrl>
    <GitHubRepository Condition="'$(GitHubRepository)' == ''"></GitHubRepository>
  </PropertyGroup>

  <!-- v1.8 replaced the old manual QuickTune page with MainWindow.AutomaticCleanup.cs.
       Exclude the obsolete partial class in case an upgrade is copied over an older Git checkout. -->
  <ItemGroup>
    <Compile Remove="MainWindow.V17.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GitHubRepository</_Parameter1>
      <_Parameter2>$(GitHubRepository)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Cleaners\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
