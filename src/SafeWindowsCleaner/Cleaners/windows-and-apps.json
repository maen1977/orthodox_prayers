[
  {
    "id": "windows-user-temp",
    "name": "الملفات المؤقتة للمستخدم",
    "description": "ملفات مؤقتة أقدم من 24 ساعة؛ يتم تجاوز الملفات المستخدمة.",
    "group": "Windows",
    "rootPath": "%TEMP%",
    "searchPatterns": ["*"],
    "recursive": true,
    "minimumAgeHours": 24,
    "enabledByDefault": true,
    "safetyTier": "Safe"
  },
