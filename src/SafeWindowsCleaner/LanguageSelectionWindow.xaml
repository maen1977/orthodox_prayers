<Window x:Class="SafeWindowsCleaner.LanguageSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UI.Language.Title}"
        Width="500" Height="470" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="True">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="LanguageHeadingText" Text="{DynamicResource UI.Language.Heading}"
                       FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="LanguageDescriptionText"
                       Text="{DynamicResource UI.Language.Description}"
                       Margin="0,8,0,0" TextAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}"/>
        </StackPanel>

        <ListBox x:Name="LanguagesList" Grid.Row="2" FontSize="17"
                 SelectionMode="Single" SelectedValuePath="Code"
                 SelectionChanged="LanguagesList_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,4"/>
                    <Setter Property="Padding" Value="4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="16,12" CornerRadius="10"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button x:Name="ContinueButton" Grid.Row="4" Content="{DynamicResource UI.Language.Continue}"
                Style="{StaticResource PrimaryButton}"
                MinWidth="180" HorizontalAlignment="Center" Click="Continue_Click"/>
    </Grid>
</Window>
