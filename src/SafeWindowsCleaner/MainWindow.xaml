<Window x:Class="SafeWindowsCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UI.Main.7fc3e54399}"
        Width="1260"
        Height="760"
        MinWidth="1040"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="46" Height="46" CornerRadius="13"
                        Background="{DynamicResource PrimaryBrush}" Margin="0,0,12,0">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                               Foreground="White" FontSize="23"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource UI.Main.7fc3e54399}" FontSize="25" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource UI.Main.dfca3007af}"
                                   FontSize="13" Foreground="{DynamicResource MutedTextBrush}"/>
                        <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="8"
                                Background="{DynamicResource SecondaryBackgroundBrush}">
                            <TextBlock Text="{DynamicResource UI.Main.bbbe9f538e}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="PreviewModeStatusText" Margin="0,4,0,0" FontSize="12"
                               FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderPrivilegeText" VerticalAlignment="Center"
                           Margin="0,0,10,0" Foreground="{DynamicResource MutedTextBrush}"/>
                <Button x:Name="AdvancedToolsButton" Content="{DynamicResource UI.Main.d26b2eccc3}" Visibility="Collapsed"
                        Style="{StaticResource SecondaryButton}" Click="ToggleAdvancedTools_Click"
                        ToolTip="{DynamicResource UI.Main.0b009b2054}"/>
                <Button Content="{DynamicResource UI.Main.90b6c869a1}" Style="{StaticResource SecondaryButton}"
                        Click="OpenSettingsShortcut_Click" ToolTip="{DynamicResource UI.Main.fa05c49ab8}"/>
                <Button Content="{DynamicResource UI.Main.b15d9fbb03}" Style="{StaticResource SecondaryButton}"
                        Click="OpenLogs_Click" ToolTip="{DynamicResource UI.Main.74f8d3a9fb}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <TabControl x:Name="RootTabs" TabStripPlacement="Left" SelectionChanged="RootTabs_SelectionChanged">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource NavigationTabItem}"/>
                </TabControl.Resources>
                <TabItem x:Name="HomeTab" Header="{DynamicResource UI.Main.b986d8fb16}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="12,14,12,10" MaxWidth="1080">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource UI.Main.d47494fe1e}"
                                               Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{DynamicResource UI.Main.a24ff663f5}"
                                               Style="{StaticResource SectionDescription}" FontSize="14"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{DynamicResource UI.Main.fc9645825c}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="24,12" Click="HomeAnalyze_Click"
                                        ToolTip="{DynamicResource UI.Main.f9bc8ffc4c}"
                                        AutomationProperties.Name="{DynamicResource UI.Main.9a5d38a64b}"/>
                            </Grid>

                            <UniformGrid Grid.Row="2" Columns="3">
                                <Button Style="{StaticResource QuickActionButton}" Click="HomeAnalyze_Click"
                                        ToolTip="{DynamicResource UI.Main.f9bc8ffc4c}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="25" Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBlock Grid.Row="1" Text="{DynamicResource UI.Main.ec79190f6e}"
                                                   Margin="0,12,0,0" FontSize="17" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="2"
                                                   Text="{DynamicResource UI.Main.57f88e5c69}"
                                                   Margin="0,7,0,12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                        <Border Grid.Row="3" Style="{StaticResource ShortcutBadge}">
                                            <TextBlock Text="{DynamicResource UI.Main.2029b1acc0}" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                </Button>

                                <Button Style="{StaticResource QuickActionButton}" Click="HomeDisk_Click"
                                        ToolTip="{DynamicResource UI.Main.94086f3ab5}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="&#xE7F1;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="25" Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBlock Grid.Row="1" Text="{DynamicResource UI.Main.5eebc438e6}"
                                                   Margin="0,12,0,0" FontSize="17" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="2"
                                                   Text="{DynamicResource UI.Main.8eb4f3ba00}"
                                                   Margin="0,7,0,12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                        <Border Grid.Row="3" Style="{StaticResource ShortcutBadge}">
                                            <TextBlock Text="{DynamicResource UI.Main.4a3ae321e5}" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                </Button>

                                <Button Style="{StaticResource QuickActionButton}" Click="HomeApps_Click"
                                        ToolTip="{DynamicResource UI.Main.8c54a063b9}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="25" Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBlock Grid.Row="1" Text="{DynamicResource UI.Main.94ed902f4e}"
                                                   Margin="0,12,0,0" FontSize="17" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="2"
                                                   Text="{DynamicResource UI.Main.489b65f1f1}"
                                                   Margin="0,7,0,12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                        <Border Grid.Row="3" Style="{StaticResource ShortcutBadge}">
                                            <TextBlock Text="{DynamicResource UI.Main.724a16ea3c}" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                </Button>

                                <Button Style="{StaticResource QuickActionButton}" Click="HomeMemory_Click"
                                        ToolTip="{DynamicResource UI.Main.2f2a159761}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="25" Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBlock Grid.Row="1" Text="{DynamicResource UI.Main.e783792075}"
                                                   Margin="0,12,0,0" FontSize="17" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="2"
                                                   Text="{DynamicResource UI.Main.f83d466b30}"
                                                   Margin="0,7,0,12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                        <Border Grid.Row="3" Style="{StaticResource ShortcutBadge}">
                                            <TextBlock Text="{DynamicResource UI.Main.6ac97cdc5c}" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                </Button>

                                <Button Style="{StaticResource QuickActionButton}" Click="HomeRescue_Click"
                                        ToolTip="{DynamicResource UI.Main.1eb3d173d0}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="25" Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBlock Grid.Row="1" Text="{DynamicResource UI.Main.e65e80d97a}"
                                                   Margin="0,12,0,0" FontSize="17" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="2"
                                                   Text="{DynamicResource UI.Main.cb9dea3cb9}"
                                                   Margin="0,7,0,12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                        <Border Grid.Row="3" Style="{StaticResource ShortcutBadge}">
                                            <TextBlock Text="{DynamicResource UI.Main.cbe119e4a7}" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                </Button>

                                <Button Style="{StaticResource QuickActionButton}" Click="OpenSettingsShortcut_Click"
                                        ToolTip="{DynamicResource UI.Main.fa05c49ab8}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="25" Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBlock Grid.Row="1" Text="{DynamicResource UI.Main.c0f77e1e02}"
                                                   Margin="0,12,0,0" FontSize="17" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="2"
                                                   Text="{DynamicResource UI.Main.9f43daaf91}"
                                                   Margin="0,7,0,12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                        <Border Grid.Row="3" Style="{StaticResource ShortcutBadge}">
                                            <TextBlock Text="{DynamicResource UI.Main.6284be5305}" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </UniformGrid>

                            <UniformGrid Grid.Row="4" Columns="4">
                                <Border Style="{StaticResource CardStyle}" Margin="5" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UI.Main.1f29b38b82}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="HomeModeText" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="5" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UI.Main.1a7558fd54}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="HomeElevationText" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="5" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UI.Main.d108f93373}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="HomeQuarantineText" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="5" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UI.Main.126eeb88be}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="HomeLastActionText" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="6" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UI.Main.628bedc08e}" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="{DynamicResource UI.Main.8553159f7d}"
                                                   Style="{StaticResource SectionDescription}"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="{DynamicResource UI.Main.cd50a05489}" Style="{StaticResource SecondaryButton}" Click="OpenStorageSettings_Click"/>
                                        <Button Content="{DynamicResource UI.Main.aaa3d99371}" Style="{StaticResource SecondaryButton}" Click="OpenWindowsSecurity_Click"/>
                                        <Button Content="{DynamicResource UI.Main.799d0cb439}" Style="{StaticResource SecondaryButton}" Click="OpenWindowsUpdate_Click"/>
                                        <Button Content="{DynamicResource UI.Main.216a67172d}" Style="{StaticResource SecondaryButton}" Click="OpenTaskManager_Click"/>
                                        <Button Content="{DynamicResource UI.Main.4e9a66f7d5}" Style="{StaticResource SecondaryButton}" Click="HomeStartup_Click"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="AutomaticCleanupTab" Visibility="Collapsed" Header="{DynamicResource UI.Main.df19b0dda4}">
                    <Grid Margin="4,18,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource UI.Main.191d2a5be3}" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="{DynamicResource UI.Main.5149ad9ac6}"
                                           Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" MaxWidth="740"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="AutomaticCleanupStartButton" Content="{DynamicResource UI.Main.af4750afbc}"
                                        Style="{StaticResource PrimaryButton}" Click="RunAutomaticCleanup_Click"/>
                                <Button x:Name="AutomaticCleanupCancelButton" Content="{DynamicResource UI.Main.0a390cb74a}" IsEnabled="False"
                                        Style="{StaticResource DangerButton}" Click="CancelAutomaticCleanup_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="10" Padding="15">
                            <StackPanel>
                                <TextBlock x:Name="AutomaticCleanupSummaryText"
                                           Text="{DynamicResource UI.Main.c67f51fd9c}"
                                           TextWrapping="Wrap"/>
                                <ProgressBar x:Name="AutomaticCleanupProgressBar" Margin="0,12,0,5" Height="12" Minimum="0" Maximum="100" Value="0"/>
                                <TextBlock x:Name="AutomaticCleanupStageText" Text="{DynamicResource UI.Main.e1c009bc47}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <UniformGrid Grid.Row="4" Columns="4">
                            <Border Style="{StaticResource CardStyle}" Margin="5" Padding="13">
                                <StackPanel><TextBlock Text="{DynamicResource UI.Main.296402972a}" FontWeight="Bold"/><TextBlock Text="{DynamicResource UI.Main.41fcae4607}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="5" Padding="13">
                                <StackPanel><TextBlock Text="{DynamicResource UI.Main.6de972092f}" FontWeight="Bold"/><TextBlock Text="{DynamicResource UI.Main.ab723fffdb}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="5" Padding="13">
                                <StackPanel><TextBlock Text="{DynamicResource UI.Main.b7c33d0637}" FontWeight="Bold"/><TextBlock Text="{DynamicResource UI.Main.7bf203e19e}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="5" Padding="13">
                                <StackPanel><TextBlock Text="{DynamicResource UI.Main.e30df73edf}" FontWeight="Bold"/><TextBlock Text="{DynamicResource UI.Main.12204754d0}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="6" Style="{StaticResource CardStyle}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource UI.Main.8715175b2c}" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="{DynamicResource UI.Main.9e51a360a8}"/>
                                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                           Text="{DynamicResource UI.Main.4550242c06}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="8" Orientation="Horizontal">
                            <Button x:Name="AutomaticCleanupOpenReportButton" Content="{DynamicResource UI.Main.e0b9172a50}" IsEnabled="False"
                                    Style="{StaticResource SecondaryButton}" Click="OpenLatestAutomaticReport_Click"/>
                            <Button Content="{DynamicResource UI.Main.65efe307a7}" Style="{StaticResource SecondaryButton}" Click="OpenAutomaticReportsFolder_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem x:Name="CleanupTab" Header="{DynamicResource UI.Main.abcc101a71}">
                    <Grid Margin="4,18,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource UI.Main.ca203ba55d}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock x:Name="CleanupSummaryText"
                                           Text="{DynamicResource UI.Main.ceb796c9a9}"
                                           Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ComboBox x:Name="CleanupProfileComboBox" Width="190" Margin="4" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CleanupProfile_SelectionChanged" ToolTip="{DynamicResource UI.Main.3143f322bc}" Visibility="Collapsed"/>
                                <Button Content="{DynamicResource UI.Main.dc42087e53}" Style="{StaticResource SecondaryButton}" Click="SelectAllCleanup_Click" Visibility="Collapsed"/>
                                <Button Content="{DynamicResource UI.Main.41640caf21}" Style="{StaticResource SecondaryButton}" Click="SelectNoneCleanup_Click" Visibility="Collapsed"/>
                                <Button Content="{DynamicResource UI.Main.3813ee166f}" Style="{StaticResource PrimaryButton}" Click="ScanCleanup_Click"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid x:Name="CleanupItemsGrid" Grid.Row="2" ItemsSource="{Binding CleanupTargets}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="{DynamicResource UI.Main.b7c961751f}" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                <DataGridTextColumn Header="{DynamicResource UI.Main.8f0d3526b3}" Binding="{Binding DisplayGroup}" Width="105" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{DynamicResource UI.Main.59de6a8f17}" Binding="{Binding DisplayName}" Width="200" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{DynamicResource UI.Main.45b6f94910}" Binding="{Binding SafetyText}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{DynamicResource UI.Main.a9965b94a4}" Binding="{Binding DisplayDescription}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{DynamicResource UI.Main.fb6ffdbdae}" Binding="{Binding FileCount}" Width="110" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{DynamicResource UI.Main.be45eacde7}" Binding="{Binding SizeText}" Width="120" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource UI.Main.680308c23a}"
                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                            <Button Grid.Column="1" Content="{DynamicResource UI.Main.58e52a605d}"
                                    Style="{StaticResource DangerButton}" Click="CleanSelected_Click"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="DiskAnalyzerTab" Visibility="Collapsed" Header="{DynamicResource UI.Main.36ed65c3f2}">
                    <Grid Margin="4,18,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource UI.Main.87de769bc2}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock x:Name="DiskSummaryText"
                                           Text="{DynamicResource UI.Main.d014c332c4}"
                                           Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{DynamicResource UI.Main.c229922d01}"
                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DiskPathBox" MinWidth="350" ToolTip="{DynamicResource UI.Main.f7d1a4ee0b}"/>
                            <CheckBox x:Name="DiskDuplicateScanCheckBox" Grid.Column="1" Margin="10,0"
                                      Content="{DynamicResource UI.Main.939899e92d}" ToolTip="{DynamicResource UI.Main.6ae5da2542}"/>
                            <Button Grid.Column="2" Content="{DynamicResource UI.Main.a36dd567c8}" Style="{StaticResource SecondaryButton}" Click="BrowseDiskPath_Click"/>
                            <Button Grid.Column="3" Content="{DynamicResource UI.Main.ede8b47baf}" Style="{StaticResource PrimaryButton}" Click="ScanDisk_Click"/>
                            <Button x:Name="DiskCancelButton" Grid.Column="4" Content="{DynamicResource UI.Main.0a390cb74a}" IsEnabled="False"
                                    Style="{StaticResource DangerButton}" Click="CancelDiskScan_Click"/>
                        </Grid>

                        <TabControl Grid.Row="4">
                            <TabItem Header="{DynamicResource UI.Main.3b66004a9a}">
                                <DataGrid x:Name="DiskLargestFilesGrid" ItemsSource="{Binding DiskLargestFiles}" Margin="0,10,0,0">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="{DynamicResource UI.Main.e08ca265fd}" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                        <DataGridTextColumn Header="{DynamicResource UI.Main.1529edde32}" Binding="{Binding Name}" Width="190" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="{DynamicResource UI.Main.033626158b}" Binding="{Binding CategoryText}" Width="125" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="{DynamicResource UI.Main.27c6651384}" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="{DynamicResource UI.Main.2d56dc0a4e}" Binding="{Binding LastModifiedText}" Width="145" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="{DynamicResource UI.Main.ccdedafa1b}" Binding="{Binding SafetyText}" Width="105" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="{DynamicResource UI.Main.a2e93da9b0}" Binding="{Binding ProtectionReasonText}" Width="185" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="{DynamicResource UI.Main.be45eacde7}" Binding="{Binding SizeText}" Width="110" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="{DynamicResource UI.Main.abdd465ba9}">
                                <DataGrid ItemsSource="{Binding DiskFolders}" Margin="0,10,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{DynamicResource UI.Main.99e8d786e5}" Binding="{Binding Name}" Width="220" IsReadOnly="True"/>
